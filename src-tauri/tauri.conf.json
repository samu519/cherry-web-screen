{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "Cherry Web Screen",
  "version": "0.1.0",
  "identifier": "com.cherry.webscreen",

  "build": {
    "beforeDevCommand": "npm run native:prepare",
    "beforeBuildCommand": "npm run native:prepare",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cherry Screen",
        "width": 480,
        "height": 1920,
        "preventOverflow": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
